# 本機 vercel dev 用：複製為 .env.local 並填入實際值（勿 commit .env.local）

# Notion（Vercel 後台也要設定相同變數名）
NOTION_API_KEY=secret_xxxxxxxx
NOTION_DATABASE_ID=340a7f1b413c8000b90dd891e28bf9b8
# 食物名稱（Title 欄，若已改名為 WhatFood 可設為 WhatFood，不設則自動偵測）
NOTION_TITLE_PROPERTY=WhatFood
# 以下選填：若 Notion 欄位名稱不同才改
# NOTION_COL_DATE=日期
# NOTION_COL_TIME=時間
# NOTION_COL_MEAL_TYPE=餐別
# NOTION_COL_MOOD=爽度
# NOTION_COL_BODY=身體感受
# NOTION_COL_MERIT=功德
# NOTION_COL_MERIT_TOTAL=功德總數
# NOTION_COL_MB=MB
# NOTION_COL_NP=NP
# NOTION_COL_HL=HL
# NOTION_COL_RV=RV
# NOTION_COL_CONTEXT=情境
# NOTION_COL_EMAIL=Email
# NOTION_COL_NICKNAME=暱稱
# NOTION_COL_GENDER=性別
# NOTION_COL_AGE=年齡
# NOTION_COL_FORTUNE=詩籤

# OpenAI（Vercel 環境變數，本機 vercel dev 用 .env.local）
OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
