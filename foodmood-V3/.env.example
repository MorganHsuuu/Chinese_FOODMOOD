# 本機 vercel dev 用：複製為 .env.local 並填入實際值（勿 commit .env.local）

# Notion（Vercel 後台也要設定相同變數名）
NOTION_API_KEY=secret_xxxxxxxx
NOTION_DATABASE_ID=340a7f1b413c8000b90dd891e28bf9b8
# 食物名稱（Title 欄，若已改名為 WhatFood 可設為 WhatFood，不設則自動偵測）
NOTION_TITLE_PROPERTY=WhatFood
# 以下選填：若 Notion 欄位名稱不同才改
# NOTION_COL_DATE=日期
# NOTION_COL_TIME=時間
# NOTION_COL_MEAL_TYPE=餐別
# NOTION_COL_MOOD=爽度          （Number 1–5 或 Select：很糟／不太好／普通／還不錯／很爽）
# NOTION_COL_BODY=身體感受      （Select 須含：腸胃作怪、油膩發脹、舒服飽足、清爽有神 等）
# 選填：拉桿／五類（Notion 有建欄才寫入，欄名需與資料庫一致）
# NOTION_COL_MOOD_TIER=心情類別
# NOTION_COL_BODY_TIER=身體類別
# NOTION_COL_MOOD_SLIDER=心情拉桿
# NOTION_COL_BODY_COMFORT=身體拉桿
# NOTION_COL_MERIT=功德
# NOTION_COL_MERIT_TOTAL=功德總數
# NOTION_COL_MB=MB
# NOTION_COL_NP=NP
# NOTION_COL_HL=HL
# NOTION_COL_RV=RV
# NOTION_COL_CONTEXT=情境
# NOTION_COL_EMAIL=Email
# NOTION_COL_NICKNAME=暱稱
# NOTION_COL_GENDER=性別
# NOTION_COL_AGE=年齡
# NOTION_COL_FORTUNE=詩籤
# NOTION_COL_PHOTO=餐點照片
# 選填：在 Notion 食緒資料庫只需新增「一欄」即可追蹤圖鑑／孵化（每次寫入會同步該使用者所有列）
# NOTION_COL_CREATURE_COLLECTION=靈獸圖鑑  （Rich text）
# 內容範例：12筆·解鎖2/16·當前織女(MPLR)·孵化第1輪織女 ◆ n:12|hatched:1|cycles:1|cur:MPLR|u:MNLR,MPLR|h:1:MPLR
# ◆ 後為程式解析用；前面為人類可讀摘要。筆數／解鎖清單／當前靈獸／各輪孵化皆由此欄還原。

# 餐點照片公開網址（Vercel Blob，後台 Storage 建立後複製 token）
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# OpenAI（Vercel 環境變數，本機 vercel dev 用 .env.local）
OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
